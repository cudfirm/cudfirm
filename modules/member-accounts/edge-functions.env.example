# Copy values into Supabase Edge Function secrets. Do not commit real secrets.
MEMBER_SITE_URL=https://example.com
MEMBER_ALLOWED_ORIGINS=https://example.com

# Optional provider-agnostic transactional email webhook.
# Required only for existing-Auth-user invitations and non-Auth notices.
MEMBER_EMAIL_WEBHOOK_URL=https://api.example.com/member-email
MEMBER_EMAIL_WEBHOOK_SECRET=replace-with-server-only-secret

# --- Service requests, enquiry notifications and client portal (migration 018) ---
# Fixed recipient for admin notifications. Never taken from visitor input.
ADMIN_NOTIFY_EMAIL=admin@example.com
# Shared secret sent by Supabase Database Webhooks to `enquiry-notify`.
ENQUIRY_WEBHOOK_SECRET=replace-with-long-random-server-only-secret
# Optional: send a fixed-template acknowledgement to the visitor (default off).
SEND_CLIENT_ACKNOWLEDGEMENT=false
